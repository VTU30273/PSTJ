import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class Solution {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int n = Integer.parseInt(scan.nextLine().trim());

        List<List<Integer>> lines = new ArrayList<>();

        for (int i = 0; i < n; i++) {
            String[] tokens = scan.nextLine().trim().split("\\s+");
            int count = Integer.parseInt(tokens[0]);
            List<Integer> row = new ArrayList<>();
            for (int j = 1; j <= count; j++) {
                row.add(Integer.parseInt(tokens[j]));
            }
            lines.add(row);
        }

        int q = Integer.parseInt(scan.nextLine().trim());
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < q; i++) {
            String[] tokens = scan.nextLine().trim().split("\\s+");
            int x = Integer.parseInt(tokens[0]); // line number (1-indexed)
            int y = Integer.parseInt(tokens[1]); // position (1-indexed)

            if (x >= 1 && x <= lines.size()) {
                List<Integer> row = lines.get(x - 1);
                if (y >= 1 && y <= row.size()) {
                    sb.append(row.get(y - 1)).append("\n");
                } else {
                    sb.append("ERROR!").append("\n");
                }
            } else {
                sb.append("ERROR!").append("\n");
            }
        }

        System.out.print(sb);
    }
}
